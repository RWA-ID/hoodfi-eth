# HoodFi Sites (build.hoodfi.name) — copy to .env.local
#
# Everything here is NEXT_PUBLIC_*, which means it is inlined into the bundle and
# readable by anyone. Nothing secret belongs in this file. The Pinata key and the paid
# RPC key live as secrets on the gateway worker, which is the whole reason this app has
# no server runtime.

# Reown/WalletConnect project ID. build.hoodfi.name is registered on the shared ID;
# leave empty to fall back to the canonical one.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Optional Alchemy key for mainnet reads (falls back to publicnode). Unlike the site's
# copy, a key here is NOT permanent — this app is never pinned, so a Vercel build can
# be replaced and the key rotated.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# ── Robinhood Chain (4663) ──
NEXT_PUBLIC_L2_REGISTRY_ADDRESS=0xf2bABA012244bdD7445129597350054E1B3aEe5C
NEXT_PUBLIC_REGISTRAR_ADDRESS=0x56be5565acc823f4195c2cf3b9046C083633209a
NEXT_PUBLIC_USDC_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168

# First block carrying a registry Transfer, verified against the chain: the parent
# self-mint is at 7211891 and test1000 at 7217181.
#
# NOT the value the site currently uses. frontend/.env.local has 15164296, which is the
# setBaseURI transaction from 2026-07-20 — nine days after the registry went live. Any
# getLogs starting there cannot see a name minted before it, and this list is what
# decides whether someone is allowed to publish on a name they own.
NEXT_PUBLIC_L2_DEPLOY_BLOCK=7211891

# The publishing paywall on Robinhood Chain. Empty until deployed; every surface that
# needs it degrades rather than throwing.
NEXT_PUBLIC_SITES_ADDRESS=

# Gateway endpoints (same worker as the site's).
NEXT_PUBLIC_SITE_UPLOAD_URL=https://hoodfi-gateway.dmpay.workers.dev/site
NEXT_PUBLIC_ANALYTICS_URL=https://hoodfi-gateway.dmpay.workers.dev/e

# This app's own origin, for absolute URLs.
NEXT_PUBLIC_SITE_URL=https://build.hoodfi.name
