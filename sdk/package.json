{
  "name": "@hoodfi/sdk",
  "version": "0.1.0",
  "description": "Resolve, reverse-look-up and register *.hoodfi.eth names on Robinhood Chain. Typed, keyless, viem-based.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:live": "npm run build && node --test test/live.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": ["hoodfi", "ens", "names", "robinhood-chain", "viem", "web3", "identity"],
  "homepage": "https://www.hoodfi.name",
  "repository": {
    "type": "git",
    "url": "https://github.com/RWA-ID/hoodfi-eth.git",
    "directory": "sdk"
  },
  "license": "MIT",
  "engines": { "node": ">=18" },
  "peerDependencies": {
    "viem": "^2.21.0"
  },
  "dependencies": {
    "@ensdomains/address-encoder": "^1.1.4"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "viem": "^2.47.10"
  },
  "publishConfig": { "access": "public" }
}
