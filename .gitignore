# secrets — never committed
.env
.env.local
.env.*.local
.dev.vars
.dev.vars.*

# build output
contracts/out/
contracts/cache/
contracts/broadcast/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
builder/.next/
builder/out/
builder/next-env.d.ts
gateway/out/
node_modules/
*.tsbuildinfo
*.log

# snapshot exports (regenerate from chain)
reservations-snapshot.json
.env.signer.json

# Local wrangler dev state
.wrangler/

# generated by builder/scripts/sync-shared.mjs at build time.
# Path-anchored on purpose: a bare `shared/` would also ignore frontend/shared/, which
# is the authored original and must stay tracked.
builder/shared/
